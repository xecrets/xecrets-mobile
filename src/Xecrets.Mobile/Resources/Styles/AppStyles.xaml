<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
    xmlns:f="clr-namespace:Fonts"
    xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:Double x:Key="sizeNone">0</x:Double>
    <x:Double x:Key="size20">2</x:Double>
    <x:Double x:Key="size40">4</x:Double>
    <x:Double x:Key="size60">6</x:Double>
    <x:Double x:Key="size80">8</x:Double>
    <x:Double x:Key="size100">10</x:Double>
    <x:Double x:Key="size120">12</x:Double>
    <x:Double x:Key="size160">16</x:Double>
    <x:Double x:Key="size200">20</x:Double>
    <x:Double x:Key="size240">24</x:Double>
    <x:Double x:Key="size280">28</x:Double>
    <x:Double x:Key="size320">32</x:Double>
    <x:Double x:Key="size360">36</x:Double>
    <x:Double x:Key="size400">40</x:Double>
    <x:Double x:Key="size480">48</x:Double>
    <x:Double x:Key="size520">52</x:Double>
    <x:Double x:Key="size560">56</x:Double>

    <!-- https://fluent2.microsoft.design/typography/ -->
    <OnIdiom x:Key="IconSize"
             x:TypeArguments="x:Double"
             Default="20">
        <OnIdiom.Desktop>32</OnIdiom.Desktop>
        <OnIdiom.Tablet>24</OnIdiom.Tablet>
    </OnIdiom>

    <OnIdiom x:Key="IconSizeSmall"
             x:TypeArguments="x:Double"
             Default="12">
        <OnIdiom.Desktop>18</OnIdiom.Desktop>
        <OnIdiom.Tablet>15</OnIdiom.Tablet>
    </OnIdiom>

    <OnIdiom x:Key="LayoutPadding"
             x:TypeArguments="Thickness"
             Default="16">
        <OnIdiom.Desktop>32</OnIdiom.Desktop>
        <OnIdiom.Tablet>32</OnIdiom.Tablet>
    </OnIdiom>

    <!-- LayoutPadding for a scrolling page above a fixed bottom area, and for that bottom area, so that the two
         together are padded as one page, with LayoutSpacing between them. -->
    <OnIdiom x:Key="LayoutPaddingWithoutBottom"
             x:TypeArguments="Thickness"
             Default="16,16,16,0">
        <OnIdiom.Desktop>32,32,32,0</OnIdiom.Desktop>
        <OnIdiom.Tablet>32,32,32,0</OnIdiom.Tablet>
    </OnIdiom>

    <OnIdiom x:Key="LayoutPaddingWithoutTop"
             x:TypeArguments="Thickness"
             Default="16,0,16,16">
        <OnIdiom.Desktop>32,0,32,32</OnIdiom.Desktop>
        <OnIdiom.Tablet>32,0,32,32</OnIdiom.Tablet>
    </OnIdiom>

    <OnIdiom x:Key="ContentTitleLayoutPadding"
             x:TypeArguments="Thickness"
             Default="16,8,16,16">
        <OnIdiom.Desktop>32,12,32,32</OnIdiom.Desktop>
        <OnIdiom.Tablet>32,12,32,32</OnIdiom.Tablet>
    </OnIdiom>

    <!-- ContentTitleLayoutPadding above a text that spans the full page width and down to the bottom of the page,
         for the breadcrumb, the card and the messages. -->
    <OnIdiom x:Key="FullWidthTextHeaderPadding"
             x:TypeArguments="Thickness"
             Default="16,8,16,0">
        <OnIdiom.Desktop>32,12,32,0</OnIdiom.Desktop>
        <OnIdiom.Tablet>32,12,32,0</OnIdiom.Tablet>
    </OnIdiom>

    <OnIdiom x:Key="LayoutSpacing"
             x:TypeArguments="x:Double"
             Default="12">
        <OnIdiom.Desktop>16</OnIdiom.Desktop>
        <OnIdiom.Tablet>16</OnIdiom.Tablet>
    </OnIdiom>

    <!-- A divider between groups of action buttons. The negative margins cancel most of the stack spacing on
         both sides, leaving the buttons around it a few pixels more than LayoutSpacing apart, which reads as
         the same spacing once the divider line is between them. -->
    <OnIdiom x:Key="ActionDividerMargin"
             x:TypeArguments="Thickness"
             Default="0,-4,0,-3">
        <OnIdiom.Desktop>0,-6,0,-5</OnIdiom.Desktop>
        <OnIdiom.Tablet>0,-6,0,-5</OnIdiom.Tablet>
    </OnIdiom>

    <Style x:Key="ActionDividerStyle"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Margin" Value="{StaticResource ActionDividerMargin}" />
        <Setter Property="Opacity" Value="0.50" />
    </Style>

    <!-- Between the card title row and the card body. -->
    <OnIdiom x:Key="CardTitleSpacing"
             x:TypeArguments="x:Double"
             Default="8">
        <OnIdiom.Desktop>12</OnIdiom.Desktop>
        <OnIdiom.Tablet>12</OnIdiom.Tablet>
    </OnIdiom>

    <!-- Between an icon button and the control beside it. -->
    <x:Double x:Key="IconRowSpacing">4</x:Double>

    <!-- Align a standalone button with the center of a row: 44-unit icon plus 4-unit gap on each side. -->
    <Thickness x:Key="IconRowActionButtonMargin">48,0</Thickness>


    <OnIdiom x:Key="CardPadding"
             x:TypeArguments="Thickness"
             Default="20">
        <OnIdiom.Desktop>24</OnIdiom.Desktop>
        <OnIdiom.Tablet>24</OnIdiom.Tablet>
    </OnIdiom>

    <OnIdiom x:Key="PageInformationBodyPadding"
             x:TypeArguments="Thickness"
             Default="16,0,16,16">
        <OnIdiom.Desktop>24,0,24,24</OnIdiom.Desktop>
        <OnIdiom.Tablet>24,0,24,24</OnIdiom.Tablet>
    </OnIdiom>

    <!-- The card body padding for a page with icon rows. The rows span the full card width, so that their
         icons line up with the icons in the card corners, such as the header actions. A negative
         row margin would do the same visually, but the part of a row outside its parent does not receive
         taps. The other content takes the horizontal padding as IconRowBodyContentMargin. -->
    <OnIdiom x:Key="IconRowBodyPadding"
             x:TypeArguments="Thickness"
             Default="0,0,0,16">
        <OnIdiom.Desktop>0,0,0,24</OnIdiom.Desktop>
        <OnIdiom.Tablet>0,0,0,24</OnIdiom.Tablet>
    </OnIdiom>

    <!-- The padding of a card footer below a body with icon rows, such as a divider and a button that stay visible
         when the body scrolls. Together with CardTitleSpacing above it, the top is LayoutSpacing, and the bottom
         is the bottom of IconRowBodyPadding, so that it looks as if the footer were the end of the body. -->
    <OnIdiom x:Key="IconRowFooterPadding"
             x:TypeArguments="Thickness"
             Default="0,4,0,16">
        <OnIdiom.Desktop>0,4,0,24</OnIdiom.Desktop>
        <OnIdiom.Tablet>0,4,0,24</OnIdiom.Tablet>
    </OnIdiom>

    <!-- For a control with a trailing icon, such as PasswordEntry, so the icon lines up with the corner icons. -->
    <OnIdiom x:Key="IconRowBodyLeadingMargin"
             x:TypeArguments="Thickness"
             Default="16,0,0,0">
        <OnIdiom.Desktop>24,0,0,0</OnIdiom.Desktop>
        <OnIdiom.Tablet>24,0,0,0</OnIdiom.Tablet>
    </OnIdiom>

    <OnIdiom x:Key="IconRowBodyContentMargin"
             x:TypeArguments="Thickness"
             Default="16,0">
        <OnIdiom.Desktop>24,0</OnIdiom.Desktop>
        <OnIdiom.Tablet>24,0</OnIdiom.Tablet>
    </OnIdiom>

    <!-- Font sizes. The default is the phone and desktop size; a tablet scales it up by about 1.25, since a point
         is the same physical size on both and the text would otherwise look small on the larger screen. -->
    <OnIdiom x:Key="FontSizeExtraFileInfo" x:TypeArguments="x:Double" Default="11" Tablet="14" />
    <OnIdiom x:Key="FontSizeCaption2" x:TypeArguments="x:Double" Default="12" Tablet="15" />
    <OnIdiom x:Key="FontSizeCaption1" x:TypeArguments="x:Double" Default="13" Tablet="16" />
    <OnIdiom x:Key="FontSizeBody2" x:TypeArguments="x:Double" Default="15" Tablet="19" />
    <!-- Buttons, editors and monospace password entries. -->
    <OnIdiom x:Key="FontSizeMedium" x:TypeArguments="x:Double" Default="16" Tablet="20" />
    <OnIdiom x:Key="FontSizeBody1" x:TypeArguments="x:Double" Default="17" Tablet="21" />
    <OnIdiom x:Key="FontSizeTitle3" x:TypeArguments="x:Double" Default="20" Tablet="25" />
    <OnIdiom x:Key="FontSizeTitle2" x:TypeArguments="x:Double" Default="22" Tablet="28" />
    <OnIdiom x:Key="FontSizeTitle1" x:TypeArguments="x:Double" Default="26" Tablet="32" />
    <OnIdiom x:Key="FontSizeLargeTitle" x:TypeArguments="x:Double" Default="34" Tablet="42" />
    <OnIdiom x:Key="FontSizeDisplay" x:TypeArguments="x:Double" Default="60" Tablet="75" />
    <OnIdiom x:Key="FontSizeFlyoutItem" x:TypeArguments="x:Double"
             Default="{OnPlatform Android=14, iOS=17, MacCatalyst=17, Default=16}"
             Tablet="{OnPlatform Android=18, Default=21}" />

    <!-- The icon in an action button, and the leading padding that keeps the button text clear of it. -->
    <OnIdiom x:Key="ActionButtonIconSize" x:TypeArguments="x:Double" Default="24" Tablet="30" />
    <OnIdiom x:Key="ActionButtonTextPadding" x:TypeArguments="Thickness" Default="50,8,18,8" Tablet="56,8,18,8" />

    <OnPlatform x:Key="MonospaceFontFamily"
                x:TypeArguments="x:String">
        <On Platform="Android" Value="monospace" />
        <On Platform="iOS, MacCatalyst" Value="Menlo" />
        <On Platform="WinUI" Value="Consolas" />
    </OnPlatform>

    <FontImageSource x:Key="IconOpenFolderButton"
                Glyph="{x:Static f:FluentUI.folder_open_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{StaticResource White}"
                Size="{StaticResource ActionButtonIconSize}" />
    <FontImageSource x:Key="IconMyFolderButton"
                Glyph="{x:Static f:FluentUI.folder_link_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{StaticResource White}"
                Size="{StaticResource ActionButtonIconSize}" />
    <FontImageSource x:Key="IconRecentFilesButton"
                Glyph="{x:Static f:FluentUI.history_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{StaticResource White}"
                Size="{StaticResource ActionButtonIconSize}" />
    <FontImageSource x:Key="IconReplaceButton"
                Glyph="{x:Static f:FluentUI.document_sync_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{StaticResource White}"
                Size="{StaticResource ActionButtonIconSize}" />
    <FontImageSource x:Key="IconCopyButton"
                Glyph="{x:Static f:FluentUI.document_copy_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{StaticResource White}"
                Size="{StaticResource ActionButtonIconSize}" />
    <FontImageSource x:Key="IconShareButton"
                Glyph="{x:Static f:FluentUI.people_lock_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{StaticResource White}"
                Size="{StaticResource ActionButtonIconSize}" />
    <FontImageSource x:Key="IconDeleteButton"
                Glyph="{x:Static f:FluentUI.delete_dismiss_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{StaticResource White}"
                Size="{StaticResource ActionButtonIconSize}" />
    <FontImageSource x:Key="IconLight"
                Glyph="{x:Static f:FluentUI.weather_sunny_28_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />
    <FontImageSource x:Key="IconSystem"
                Glyph="{x:Static f:FluentUI.system_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />
    <FontImageSource x:Key="IconDark"
                Glyph="{x:Static f:FluentUI.weather_moon_28_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />
    <FontImageSource x:Key="IconDebug"
                Glyph="{x:Static f:FluentUI.bug_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />
    <FontImageSource x:Key="IconDecryptionPasswordsMenu"
                Glyph="{x:Static f:FluentUI.key_multiple_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />
    <FontImageSource x:Key="IconSuggestPasswordMenu"
                Glyph="{x:Static f:FluentUI.password_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />
    <FontImageSource x:Key="IconRecentFilesMenu"
                Glyph="{x:Static f:FluentUI.history_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />
    <FontImageSource x:Key="IconDeleteProfileMenu"
                Glyph="{x:Static f:FluentUI.person_delete_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />

    <FontImageSource x:Key="IconChangeProfileMenu"
                Glyph="{x:Static f:FluentUI.person_edit_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />
    <FontImageSource x:Key="IconAbout"
                Glyph="{x:Static f:FluentUI.info_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />
    <FontImageSource x:Key="IconSignOut"
                Glyph="{x:Static f:FluentUI.sign_out_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                Size="{StaticResource size240}" />

    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody1}" />
        <Setter Property="LineHeight"
                Value="1.29" />
        <!-- 22 -->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Label"
           Class="FlyoutItemLabelStyle">
        <Setter Property="utilities:Typography.FontWeight" Value="Semibold" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeFlyoutItem}" />
        <Setter Property="LineHeight"
                Value="1" />
    </Style>
    <Style x:Key="Caption2"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeCaption2}" />
        <Setter Property="LineHeight"
                Value="1.33" />
        <!-- 16 -->
    </Style>
    <Style x:Key="Caption1"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeCaption1}" />
        <Setter Property="LineHeight"
                Value="1.38" />
        <!-- 18 -->
    </Style>
    <Style x:Key="Caption1Strong"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeCaption1}" />
        <Setter Property="LineHeight"
                Value="1.38" />
        <!-- 18 -->
        <Setter Property="utilities:Typography.FontWeight" Value="Semibold" />
    </Style>
    <Style x:Key="Body2"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody2}" />
        <Setter Property="LineHeight"
                Value="1.33" />
        <!-- 20 -->
    </Style>
    <Style x:Key="Body2Strong"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody2}" />
        <Setter Property="LineHeight"
                Value="1.33" />
        <!-- 20 -->
        <Setter Property="utilities:Typography.FontWeight" Value="Semibold" />
    </Style>
    <Style x:Key="Body1"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody1}" />
        <Setter Property="LineHeight"
                Value="1.29" />
        <!-- 22 -->
    </Style>
    <Style x:Key="Body1Strong"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody1}" />
        <Setter Property="LineHeight"
                Value="1.29" />
        <!-- 22 -->
        <Setter Property="utilities:Typography.FontWeight" Value="Semibold" />
    </Style>
    <Style x:Key="Title3"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeTitle3}" />
        <Setter Property="LineHeight"
                Value="1.25" />
        <!-- 25 -->
        <Setter Property="utilities:Typography.FontWeight" Value="Semibold" />
    </Style>
    <Style x:Key="Title2"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeTitle2}" />
        <Setter Property="LineHeight"
                Value="1.27" />
        <!-- 28 -->
        <Setter Property="utilities:Typography.FontWeight" Value="Semibold" />
    </Style>
    <Style x:Key="Title1"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeTitle1}" />
        <Setter Property="LineHeight"
                Value="1.23" />
        <!-- 32 -->
        <Setter Property="FontAttributes"
                Value="{OnPlatform WinUI=None, Default=Bold}" />
    </Style>
    <!-- The leading margin of a card title, the same as the padding of the icon buttons, so that the title lines
         up with the icons in the rows below it and is as far from the card edge as the trailing card icons. -->
    <Thickness x:Key="CardTitleMargin">8,0,0,0</Thickness>

    <!-- The title of a card, in the first column of the top row with the card icons in the second column. -->
    <Style x:Key="CardTitleStyle"
           TargetType="Label"
           BasedOn="{StaticResource Title1}">
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
        <Setter Property="Margin" Value="{StaticResource CardTitleMargin}" />
    </Style>
    <Style x:Key="LargeTitle"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeLargeTitle}" />
        <Setter Property="LineHeight"
                Value="1.21" />
        <!-- 41 -->
        <Setter Property="FontAttributes"
                Value="{OnPlatform WinUI=None, Default=Bold}" />
    </Style>
    <Style x:Key="Display"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="LineHeight"
                Value="1.17" />
        <!-- 70 -->
        <Setter Property="FontAttributes"
                Value="{OnPlatform WinUI=None, Default=Bold}" />
    </Style>

    <!-- The name of a file, such as in the recent files list or at the top of a file's card. -->
    <!-- The line height overrides the body text line height of the implicit Label style, which spreads out the
         lines of a file name that wraps. -->
    <Style x:Key="FileName"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeCaption1}" />
        <Setter Property="LineHeight"
                Value="1" />
    </Style>

    <!-- Information shown below a file name, such as its location or its metadata. -->
    <Style x:Key="ExtraFileInfo"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeExtraFileInfo}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>

    <Style TargetType="Border" x:Key="CardStyle">
        <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>

    <Style x:Key="PageInformationCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The height of the fade at the edge of a card body that scrolls, showing that there is more to scroll to. -->
    <x:Double x:Key="ScrollFadeHeight">40</x:Double>

    <!-- The chevron on that fade. The 16 pixel design of the glyph, drawn larger, has a bolder line than the 24 pixel
         design, so that the chevron stands out. The glyph only fills the middle of its box, so the size is
         larger than for an icon of the same visible size. -->
    <OnIdiom x:Key="ScrollChevronSize" x:TypeArguments="x:Double" Default="40" Tablet="48" />


    <!-- The height of an action button, and of the icon buttons in a row beside one, so that a row of icons and
         a button is exactly as tall as a plain action button. The minimum height overrides the 44 of the
         implicit ImageButton style, which would otherwise win over HeightRequest. -->
    <OnIdiom x:Key="ActionButtonHeight" x:TypeArguments="x:Double" Default="40" Tablet="48" />

    <!-- The minimum height of an action button with a description below the title. -->
    <OnIdiom x:Key="OneLineActionButtonHeight" x:TypeArguments="x:Double" Default="44" Tablet="52" />
    <OnIdiom x:Key="TwoLineActionButtonHeight" x:TypeArguments="x:Double" Default="60" Tablet="72" />

    <Style x:Key="ActionRowIconButtonStyle"
           TargetType="ImageButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ActionButtonHeight}" />
        <Setter Property="HeightRequest" Value="{StaticResource ActionButtonHeight}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- An icon button in the card title row, beside the page information button. -->
    <Style x:Key="CardHeaderIconButtonStyle"
           TargetType="ImageButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Button" x:Key="BaseButtonStyle">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="utilities:Typography.FontWeight" Value="Semibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ActionButtonHeight}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}" />

    <!-- For an operation that cannot be undone, such as deleting all local data. -->
    <Style TargetType="Button"
           x:Key="DestructiveButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor" Value="{StaticResource Destructive}" />
    </Style>

    <!-- The variants of the dynamic resource EntryMinimumHeight, set by LayoutMetrics.UpdateCompactHeightResources. The
         compact text fields are as tall as an action button. -->
    <OnIdiom x:Key="RegularEntryMinimumHeight" x:TypeArguments="x:Double" Default="52" Tablet="60" />
    <x:Double x:Key="CompactEntryMinimumHeight">40</x:Double>

    <!-- The variants of the dynamic resource PasswordStrengthMargin, for the strength meter below a password text
         field. The compact meter is on the underline of the text field, and with the stack spacing around it takes no
         height, so the text fields above and below it are as far apart as any others. -->
    <OnIdiom x:Key="RegularPasswordStrengthMargin"
             x:TypeArguments="Thickness"
             Default="16,-6,0,0">
        <OnIdiom.Desktop>24,-8,0,0</OnIdiom.Desktop>
        <OnIdiom.Tablet>24,-8,0,0</OnIdiom.Tablet>
    </OnIdiom>
    <Thickness x:Key="CompactPasswordStrengthMargin">16,-26,0,-2</Thickness>
    <!-- The underline of a text field ends a little in from the sides of the field, such as by the inset of the
         background on Android or the rounded corners on Windows. The strength meter is inset as much, by the dynamic
         resource PasswordStrengthInset set by LayoutMetrics.UpdateDensityResources. -->
    <x:Double x:Key="TextFieldUnderlineInset">4</x:Double>

    <!-- Applied to derived types too, such as PasswordTextEntry, so a password looks the same as other text fields. -->
    <Style TargetType="Entry"
           ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LightMutedText}, Dark={StaticResource DarkMutedText}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody1}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource EntryMinimumHeight}" />
    </Style>

    <!-- Applied to derived types too, such as ReadOnlyEditor. -->
    <Style TargetType="Editor"
           ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
    </Style>

    <!-- Error and status text, selectable. -->
    <Style TargetType="controls:ReadOnlyEditor" x:Key="StatusTextStyle">
        <Setter Property="TextColor" Value="Red" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption1}" />
        <Setter Property="AutoSize" Value="TextChanges" />
    </Style>

    <!-- Informational text, selectable, visually distinct from errors. -->
    <Style TargetType="controls:ReadOnlyEditor" x:Key="MessageTextStyle">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption1}" />
        <Setter Property="AutoSize" Value="TextChanges" />
    </Style>

    <Style TargetType="BoxView" x:Key="ShimmerCustomViewStyle">
        <Setter Property="BackgroundColor" Value="Gray" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

</ResourceDictionary>
