<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer rules for Android 12 and later. The Device directory, IFileService.DeviceDirectory,
     must never leave the device. Keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="Device" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="Device" />
    </device-transfer>
</data-extraction-rules>
