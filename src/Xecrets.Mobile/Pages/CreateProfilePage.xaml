<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
             xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
             xmlns:pages="clr-namespace:Xecrets.Mobile.Pages"
             xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
             xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
             x:Class="Xecrets.Mobile.Pages.CreateProfilePage"
             x:Name="PageRoot"
             x:DataType="pageModels:CreateProfilePageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <utilities:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <utilities:StrengthColorToColorConverter x:Key="StrengthColorToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid x:Name="ContentRoot"
          Padding="{StaticResource LayoutPadding}"
          RowSpacing="{StaticResource LayoutSpacing}">
        <Border x:Name="ContentColumn"
                VerticalOptions="Start"
                HorizontalOptions="Center"
                Style="{StaticResource PageInformationCardStyle}">
            <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource CardTitleSpacing}">
                <ScrollView Grid.Row="1">
                    <Grid x:Name="ContentBody" Padding="{StaticResource IconRowBodyPadding}">
                        <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                        <Entry Margin="{StaticResource IconRowBodyContentMargin}" Text="{Binding Email}"
                               Placeholder="{x:Static modelUtilities:MobileTexts.WatermarkEmail}"
                               Keyboard="Email"
                               ReturnType="Next" />
                        <controls:PasswordEntry Margin="{StaticResource IconRowBodyLeadingMargin}" x:Name="PasswordEntryControl"
                                                Text="{Binding Password, Mode=TwoWay}"
                                                Placeholder="{x:Static modelUtilities:MobileTexts.WatermarkPassword}"
                                                ToolTipProperties.Text="{x:Static modelUtilities:MobileTexts.ToolTipMasterPassword}"
                                                ReturnType="Next" />
                        <ProgressBar HorizontalOptions="Start"
                                     WidthRequest="{Binding PasswordTextEntry.Width, Source={x:Reference PageRoot}, x:DataType=pages:CreateProfilePage}"
                                     Progress="{Binding PasswordStrength}"
                                     ProgressColor="{Binding PasswordStrengthColor, Converter={StaticResource StrengthColorToColorConverter}}">
                            <ProgressBar.Margin>
                                <OnIdiom x:TypeArguments="Thickness"
                                         Default="16,-6,0,0">
                                    <OnIdiom.Desktop>24,-8,0,0</OnIdiom.Desktop>
                                </OnIdiom>
                            </ProgressBar.Margin>
                            <!-- Opacity, not IsVisible, so the space stays reserved and nothing moves when typing starts. -->
                            <ProgressBar.Triggers>
                                <DataTrigger TargetType="ProgressBar"
                                             Binding="{Binding Password}"
                                             Value="">
                                    <Setter Property="Opacity"
                                            Value="0" />
                                </DataTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                        <controls:PasswordEntry Margin="{StaticResource IconRowBodyLeadingMargin}" x:Name="ConfirmPasswordEntryControl"
                                                Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                                Placeholder="{x:Static modelUtilities:MobileTexts.WatermarkConfirmPassword}"
                                                ToolTipProperties.Text="{x:Static modelUtilities:MobileTexts.ToolTipMasterPassword}"
                                                ReturnType="Go" />
                        <Label Margin="{StaticResource IconRowBodyContentMargin}" Text="{Binding ErrorText}"
                               TextColor="Red"
                               IsVisible="{Binding ErrorText, Converter={StaticResource StringNotEmptyConverter}}"
                               Style="{StaticResource Caption1}" />
                        <VerticalStackLayout x:Name="ActionButtonStack" Margin="{StaticResource IconRowBodyContentMargin}"
                                             HorizontalOptions="Center"
                                             Spacing="{StaticResource LayoutSpacing}">
                            <Button Text="{x:Static modelUtilities:MobileTexts.ButtonCreate}"
                                    Command="{Binding CreateCommand}" />
                        </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </ScrollView>
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Text="{x:Static modelUtilities:MobileTexts.HeadingCreateUserFirstTimeSetup}"
                           Style="{StaticResource CardTitleStyle}" />
                    <controls:PageInformationButton Grid.Column="1"
                                                    Style="{StaticResource PageInformationButtonCorner}"
                                                    Title="{x:Static modelUtilities:MobileTexts.HeadingCreateUserFirstTimeSetup}"
                                                    Message="{x:Static modelUtilities:MobileTexts.ToolTipEmail}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
