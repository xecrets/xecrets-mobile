<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
             xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
             xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
             x:Class="Xecrets.Mobile.Pages.EditPage"
             x:ClassModifier="internal"
             x:DataType="pageModels:EditPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <FontImageSource x:Key="IconSave"
                             Glyph="{x:Static f:FluentUI.save_24_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="24" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <!-- The same layout as the view page. The card holds the file and the buttons, with no title since the
             breadcrumb names the page. The messages below it take no space when there are none, and the text below
             them spans the full page width, and is all that scrolls. -->
        <Grid RowDefinitions="Auto,*"
              RowSpacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout Padding="{StaticResource FullWidthTextHeaderPadding}"
                                 Spacing="{StaticResource LayoutSpacing}">
                <controls:PageBreadcrumb Text="{Binding Breadcrumb}" />
                <Border Style="{StaticResource PageInformationCardStyle}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Margin="{StaticResource IconRowBodyLeadingMargin}"
                                             VerticalOptions="Center">
                            <Label Text="{Binding FileNameText}"
                                   Style="{StaticResource FileName}" />
                            <Label Text="{Binding MetadataText}"
                                   Style="{StaticResource ExtraFileInfo}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1"
                                               VerticalOptions="Start">
                            <controls:TextFontButtons BindingContext="{Binding Font}" />
                            <ImageButton VerticalOptions="Center"
                                         Background="Transparent"
                                         MinimumWidthRequest="36"
                                         Padding="6,8"
                                         Source="{StaticResource IconSave}"
                                         Command="{Binding SaveCommand}" />
                            <controls:PageInformationButton Style="{StaticResource PageInformationButtonCorner}"
                                                            Title="{x:Static modelUtilities:MobileTexts.EditContentTitle}"
                                                            Message="{x:Static modelUtilities:MobileTexts.EditDescription}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
                <controls:PageMessages MessageText="{Binding MessageText}"
                                       StatusText="{Binding StatusText}" />
            </VerticalStackLayout>
            <!-- The scroll view scrolls the text, since the editor's own scrolling does not fling. -->
            <ScrollView Grid.Row="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                <Editor Text="{Binding Text, Mode=TwoWay}"
                        AutoSize="TextChanges"
                        BackgroundColor="Transparent"
                        FontSize="{Binding Font.FontSize}">
                    <Editor.Triggers>
                        <DataTrigger TargetType="Editor"
                                     Binding="{Binding Font.IsProportionalFont}"
                                     Value="False">
                            <Setter Property="FontFamily"
                                    Value="{StaticResource MonospaceFontFamily}" />
                        </DataTrigger>
                    </Editor.Triggers>
                </Editor>
            </ScrollView>
        </Grid>
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
