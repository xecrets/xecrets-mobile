<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:models="clr-namespace:Xecrets.Mobile.Models.Models;assembly=Xecrets.Mobile.Models"
             xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
             xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
             xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
             x:Class="Xecrets.Mobile.Pages.WelcomePage"
             x:DataType="pageModels:WelcomePageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <utilities:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <!-- Icon and text in separate columns, so a wrapped line aligns with the text and not the icon. -->
            <DataTemplate x:Key="WelcomeLineTemplate"
                          x:DataType="models:WelcomeLine">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="0">
                    <Label Text="{Binding Icon}"
                           IsVisible="{Binding Icon, Converter={StaticResource StringNotEmptyConverter}}"
                           FontFamily="{x:Static f:FluentUI.FontFamily}"
                           FontSize="{StaticResource IconSize}"
                           TextColor="{StaticResource Magenta}"
                           VerticalOptions="Center"
                           Margin="0,0,12,0" />
                    <Label Grid.Column="1"
                           Text="{Binding Text}"
                           Style="{StaticResource Body1}"
                           VerticalOptions="Center" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout x:Name="ContentRoot"
                             Padding="{StaticResource LayoutPadding}"
                             Spacing="{StaticResource LayoutSpacing}">
            <Label Text="{Binding Heading}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource Title1}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Introduction}"
                                 BindableLayout.ItemTemplate="{StaticResource WelcomeLineTemplate}"
                                 Spacing="{StaticResource IconRowSpacing}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}"
                                 BindableLayout.ItemTemplate="{StaticResource WelcomeLineTemplate}"
                                 Spacing="{StaticResource IconRowSpacing}"
                                 Margin="0,8,0,0" />

            <HorizontalStackLayout IsVisible="{Binding IsDontShowAgainAvailable}">
                <CheckBox IsChecked="{Binding DontShowAgain}"
                          VerticalOptions="Center" />
                <Label Text="{x:Static modelUtilities:MobileTexts.DontShowAgain}"
                       Style="{StaticResource Body1}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout x:Name="ActionButtonStack"
                                 HorizontalOptions="Center"
                                 Spacing="{StaticResource LayoutSpacing}">
                <Button Text="{x:Static modelUtilities:MobileTexts.ButtonOk}"
                        Command="{Binding OkCommand}" />
                <Button Text="{x:Static modelUtilities:MobileTexts.MenuInfo}"
                        Command="{Binding OpenXecretsHomeCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
