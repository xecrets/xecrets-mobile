<pages:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:f="clr-namespace:Fonts"
                xmlns:behaviors="clr-namespace:Xecrets.Mobile.Behaviors"
                xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
                xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
                xmlns:pages="clr-namespace:Xecrets.Mobile.Pages"
                xmlns:system="clr-namespace:System;assembly=System.Runtime"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
                xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
                x:Class="Xecrets.Mobile.Pages.EnterPasswordPage"
                x:ClassModifier="internal"
                x:TypeArguments="pageModels:EnterPasswordPageModel"
                x:Name="PageRoot"
                x:DataType="pageModels:EnterPasswordPageModel">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior x:TypeArguments="system:EventArgs"
                                        x:DataType="pages:EnterPasswordPage"
                                        BindingContext="{x:Reference PageRoot}"
                                        EventName="Appearing"
                                        Command="{Binding Model.LoadCommand}" />
        <toolkit:EventToCommandBehavior x:TypeArguments="system:EventArgs"
                                        x:DataType="pages:EnterPasswordPage"
                                        BindingContext="{x:Reference PageRoot}"
                                        EventName="Disappearing"
                                        Command="{Binding Model.LeaveCommand}" />
    </ContentPage.Behaviors>
    <ContentPage.Resources>
        <ResourceDictionary>
            <utilities:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <FontImageSource x:Key="IconAdd"
                             Glyph="{x:Static f:FluentUI.add_24_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="24" />
            <FontImageSource x:Key="IconDelete"
                             Glyph="{x:Static f:FluentUI.delete_28_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="28" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <Grid x:Name="ContentRoot"
              RowDefinitions="Auto,*"
              Padding="{StaticResource LayoutPadding}">
            <controls:PageBreadcrumb Text="{Binding Breadcrumb}" />
            <controls:PageCard x:Name="Card"
                               Grid.Row="1"
                               Title="{Binding Heading}"
                               BodyPadding="{StaticResource IconRowBodyPadding}">
                <controls:PageCard.HeaderActions>
                    <ImageButton Style="{StaticResource CardHeaderIconButtonStyle}"
                                 Source="{StaticResource IconAdd}"
                                 Command="{Binding AddCommand}" />
                </controls:PageCard.HeaderActions>
                <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}"
                                     InputTransparent="{Binding IsBusy}">
                    <!-- Without any passwords, the page information is shown. -->
                    <Border Margin="{StaticResource IconRowBodyContentMargin}"
                            IsVisible="{Binding NoPasswordsText, Converter={StaticResource StringNotEmptyConverter}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"
                            Stroke="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"
                            StrokeShape="RoundRectangle 4"
                            Padding="10,6">
                        <Label Text="{Binding NoPasswordsText}"
                               FontSize="{StaticResource FontSizeCaption1}" />
                    </Border>
                    <VerticalStackLayout IsVisible="{Binding IsAdding}"
                                         Spacing="{StaticResource LayoutSpacing}">
                        <Label Margin="{StaticResource IconRowBodyContentMargin}"
                               Text="{Binding FileNameText}"
                               IsVisible="{Binding FileNameText, Converter={StaticResource StringNotEmptyConverter}}"
                               Style="{StaticResource FileName}" />
                        <controls:PasswordEntry Margin="{StaticResource IconRowBodyLeadingMargin}" x:Name="PasswordEntryControl"
                                                Text="{Binding Password, Mode=TwoWay}"
                                                Placeholder="{x:Static modelUtilities:MobileTexts.WatermarkPassword}"
                                                ReturnType="Go"
                                                ReturnCommand="{Binding SubmitCommand}" />
                        <Label Margin="{StaticResource IconRowBodyContentMargin}" Text="{Binding ErrorText}"
                               TextColor="Red"
                               IsVisible="{Binding ErrorText, Converter={StaticResource StringNotEmptyConverter}}"
                               Style="{StaticResource Caption1}" />
                        <VerticalStackLayout x:Name="ActionButtonStack" Margin="{StaticResource IconRowBodyContentMargin}"
                                             HorizontalOptions="Center"
                                             Spacing="{StaticResource LayoutSpacing}">
                            <Button Text="{x:Static modelUtilities:MobileTexts.ButtonOk}"
                                    Command="{Binding SubmitCommand}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}"
                                         BindableLayout.ItemsSource="{Binding Passwords}">
                        <VerticalStackLayout.Behaviors>
                            <behaviors:ReleaseRemovedCommandsBehavior />
                        </VerticalStackLayout.Behaviors>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="{StaticResource IconRowSpacing}">
                                    <controls:PasswordEntry Margin="{StaticResource IconRowBodyLeadingMargin}"
                                                            Text="{Binding ., Mode=OneWay}"
                                                            IsReadOnly="True" />
                                    <ImageButton Grid.Column="1"
                                                 Background="Transparent"
                                                 Padding="8"
                                                 Source="{StaticResource IconDelete}"
                                                 Command="{Binding Model.DeleteCommand,
                                                       Source={x:Reference PageRoot},
                                                       x:DataType=pages:EnterPasswordPage}"
                                                 CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </controls:PageCard>
        </Grid>
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</pages:PageBase>
