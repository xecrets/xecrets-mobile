<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:pageControls="clr-namespace:Xecrets.Mobile.Controls"
             xmlns:mobileModels="clr-namespace:Xecrets.Mobile.Models.Models;assembly=Xecrets.Mobile.Models"
             xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
             xmlns:pages="clr-namespace:Xecrets.Mobile.Pages"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
             xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
             x:Class="Xecrets.Mobile.Pages.WorkFoldersPage"
             x:Name="PageRoot"
             x:DataType="pageModels:WorkFoldersPageModel">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior x:TypeArguments="system:EventArgs"
                                        x:DataType="pages:WorkFoldersPage"
                                        BindingContext="{x:Reference PageRoot}"
                                        EventName="Appearing"
                                        Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>
    <ContentPage.Resources>
        <ResourceDictionary>
            <utilities:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="ContentRoot"
                                 Padding="{StaticResource LayoutPadding}"
                                 Spacing="{StaticResource LayoutSpacing}">
                <pageControls:PageBreadcrumb Text="{Binding Breadcrumb}" />
                <Border x:Name="ContentColumn"
                        HorizontalOptions="Center"
                        Style="{StaticResource PageInformationCardStyle}">
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid x:Name="ContentBody" Grid.Row="1" Padding="{StaticResource PageInformationBodyPadding}">
                            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                            <Label Text="{x:Static modelUtilities:MobileTexts.WorkFoldersContentTitle}"
                                   HorizontalOptions="Center"
                                   Style="{StaticResource Title1}" />
                            <pageControls:PageMessages MessageText="{Binding MessageText}"
                                                       StatusText="{Binding StatusText}" />
                            <VerticalStackLayout x:Name="ActionButtonStack"
                                                 HorizontalOptions="Center"
                                                 Spacing="{StaticResource LayoutSpacing}"
                                                 BindableLayout.ItemsSource="{Binding Folders}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="mobileModels:WorkFolderEntry">
                                    <!-- Rename leads and remove trails, so that the two are as far apart as
                                         the row allows and neither is a likely mis-tap for the other. -->
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="{StaticResource LayoutSpacing}">
                                        <ImageButton Grid.Column="0"
                                                     Background="Transparent"
                                                     Padding="8"
                                                     Command="{Binding RenameCommand}"
                                                     CommandParameter="{Binding Folder}">
                                            <ImageButton.Source>
                                                <FontImageSource Glyph="{x:Static f:FluentUI.edit_28_regular}"
                                                                 FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                 Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                                 Size="28" />
                                            </ImageButton.Source>
                                        </ImageButton>
                                        <Button Grid.Column="1"
                                                Text="{Binding ListDisplayName}"
                                                LineBreakMode="MiddleTruncation"
                                                Command="{Binding OpenCommand}"
                                                CommandParameter="{Binding Folder}" />
                                        <ImageButton Grid.Column="2"
                                                     Background="Transparent"
                                                     Padding="8"
                                                     Command="{Binding RemoveCommand}"
                                                     CommandParameter="{Binding Folder}">
                                            <ImageButton.Source>
                                                <FontImageSource Glyph="{x:Static f:FluentUI.delete_28_regular}"
                                                                 FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                 Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                                 Size="28" />
                                            </ImageButton.Source>
                                        </ImageButton>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                        <ImageButton Grid.Row="0"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Start"
                                     Background="Transparent"
                                     Padding="8"
                                     Command="{Binding AddCommand}">
                            <ImageButton.Source>
                                <FontImageSource Glyph="{x:Static f:FluentUI.add_28_regular}"
                                                 FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                 Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                 Size="28" />
                            </ImageButton.Source>
                        </ImageButton>
                        <pageControls:PageInformationButton Grid.Row="0"
                                                             Style="{StaticResource PageInformationButtonCorner}"
                                                             Title="{x:Static modelUtilities:MobileTexts.WorkFoldersContentTitle}"
                                                             Message="{Binding Description}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
