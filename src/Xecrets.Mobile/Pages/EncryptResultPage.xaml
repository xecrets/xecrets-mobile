<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
             xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
             xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
             xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
             x:Class="Xecrets.Mobile.Pages.EncryptResultPage"
             x:DataType="pageModels:EncryptResultPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <utilities:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="ContentRoot"
                                 Padding="{StaticResource ContentTitleLayoutPadding}"
                                 Spacing="{StaticResource LayoutSpacing}">
                <Border x:Name="ContentColumn"
                        HorizontalOptions="Center"
                        Style="{StaticResource PageInformationCardStyle}">
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid x:Name="ContentBody" Grid.Row="1" Padding="{StaticResource PageInformationBodyPadding}">
                            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                            <Label Text="{Binding FileNameText}"
                                   Style="{StaticResource FileNameStyle}" />
                            <Label Text="{Binding MetadataText}"
                                   Style="{StaticResource Body2}" />
                            <controls:PageMessages MessageText="{Binding MessageText}"
                                                   StatusText="{Binding StatusText}" />
                            <VerticalStackLayout x:Name="ActionButtonStack"
                                                 HorizontalOptions="Center"
                                                 Spacing="{StaticResource LayoutSpacing}">
                                <Button Text="{x:Static modelUtilities:MobileTexts.ButtonSaveAs}"
                                        Command="{Binding SaveAsCommand}" />
                                <Button Text="{x:Static modelUtilities:MobileTexts.ButtonSendTo}"
                                        Command="{Binding SendToCommand}" />
                            </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                        <controls:PageInformationButton Grid.Row="0"
                                                        Style="{StaticResource PageInformationButtonCorner}"
                                                        Title="{Binding FileNameText}"
                                                        Message="{x:Static modelUtilities:MobileTexts.DialogTextResult}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
