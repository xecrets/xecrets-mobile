<pages:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
                xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
                xmlns:pages="clr-namespace:Xecrets.Mobile.Pages"
                xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
                xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
                x:Class="Xecrets.Mobile.Pages.ResetPasswordPage"
                x:ClassModifier="internal"
                x:TypeArguments="pageModels:ResetPasswordPageModel"
                x:Name="PageRoot"
                x:DataType="pageModels:ResetPasswordPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <utilities:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid x:Name="ContentRoot"
          Padding="{StaticResource LayoutPadding}">
        <controls:PageCard x:Name="Card"
                           Title="{Binding Heading}"
                           IsTitleAlwaysVisible="True"
                           BodyPadding="{StaticResource IconRowBodyPadding}">
            <VerticalStackLayout Spacing="{DynamicResource FormSpacing}"
                                 Margin="{DynamicResource FormMargin}">
                <!-- The page information is always shown, so that the warning is not missed. On a phone in landscape
                     there is not room for it, and it's shown as a transient message instead. -->
                <Border x:Name="InformationBox"
                        Margin="{StaticResource IconRowBodyContentMargin}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"
                        Stroke="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"
                        StrokeShape="RoundRectangle 4"
                        Padding="10,6">
                    <Label Text="{Binding Information}"
                           FontSize="{StaticResource FontSizeCaption1}" />
                </Border>
                <!-- Visible, so password managers save the new password under this email. As wide as the password text
                     field, so both have the same left and right edges. -->
                <Entry Margin="{StaticResource IconRowBodyLeadingMargin}" x:Name="EmailEntry" Text="{Binding Email}"
                       HorizontalOptions="Start"
                       WidthRequest="{Binding PasswordTextEntry.Width, Source={x:Reference PageRoot}, x:DataType=pages:ResetPasswordPage}"
                       Keyboard="Email"
                       IsReadOnly="True" />
                <controls:NewPasswordFields x:Name="NewPasswordControl"
                                            ReturnCommand="{Binding ResetCommand}" />
                <Label Margin="{StaticResource IconRowBodyContentMargin}" Text="{Binding ErrorText}"
                       TextColor="Red"
                       IsVisible="{Binding ErrorText, Converter={StaticResource StringNotEmptyConverter}}"
                       Style="{StaticResource Caption1}" />
                <VerticalStackLayout x:Name="ActionButtonStack" Margin="{StaticResource IconRowBodyContentMargin}"
                                     HorizontalOptions="Center"
                                     Spacing="{StaticResource LayoutSpacing}">
                    <Button Text="{x:Static modelUtilities:MobileTexts.ButtonReset}"
                            Style="{StaticResource DestructiveButtonStyle}"
                            Command="{Binding ResetCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </controls:PageCard>
    </Grid>
</pages:PageBase>
