<pages:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
                xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
                xmlns:pages="clr-namespace:Xecrets.Mobile.Pages"
                xmlns:system="clr-namespace:System;assembly=System.Runtime"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
                xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
                x:Class="Xecrets.Mobile.Pages.AboutPage"
                x:ClassModifier="internal"
                x:TypeArguments="pageModels:AboutPageModel"
                x:Name="PageRoot"
                x:DataType="pageModels:AboutPageModel">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior x:TypeArguments="system:EventArgs"
                                        x:DataType="pages:AboutPage"
                                        BindingContext="{x:Reference PageRoot}"
                                        EventName="Appearing"
                                        Command="{Binding Model.InitializeCommand}" />
    </ContentPage.Behaviors>
    <ContentPage.Resources>
        <ResourceDictionary>
            <utilities:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <controls:FadingScrollView FadeColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}">
            <controls:PageBreadcrumb Text="{Binding Breadcrumb}" />
            <VerticalStackLayout Spacing="{DynamicResource FormSpacing}">
                <Label x:Name="ProductNameTitle"
                       Text="{Binding ProductName}"
                       HorizontalOptions="Center"
                       Style="{StaticResource Title1}" />
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="{DynamicResource DetailRowSpacing}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="{DynamicResource DetailRowSpacing}">
                            <Label Text="{x:Static modelUtilities:MobileTexts.AboutLabelVersion}"
                                   Style="{StaticResource Body2Strong}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Version}"
                                   Style="{StaticResource Body2}" />

                            <Label Grid.Row="1"
                                   Text="{x:Static modelUtilities:MobileTexts.AboutLabelPublisher}"
                                   Style="{StaticResource Body2Strong}" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Publisher}"
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource Primary}"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenBrowserCommand}"
                                                          CommandParameter="{x:Static modelUtilities:MobileTexts.SiteUrl}" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Grid.Row="2"
                                   Text="{x:Static modelUtilities:MobileTexts.AboutLabelPlatform}"
                                   Style="{StaticResource Body2Strong}" />
                            <Label Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding Platform}"
                                   Style="{StaticResource Body2}" />

                            <Label Grid.Row="3"
                                   Text="{x:Static modelUtilities:MobileTexts.AboutLabelLicense}"
                                   Style="{StaticResource Body2Strong}" />
                            <Label Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding License}"
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource Primary}"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenBrowserCommand}"
                                                          CommandParameter="https://www.gnu.org/licenses/gpl-3.0.html" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Grid.Row="4"
                                   Text="{x:Static modelUtilities:MobileTexts.AboutLabelSourceCode}"
                                   Style="{StaticResource Body2Strong}" />
                            <Label Grid.Row="4"
                                   Grid.Column="1"
                                   Text="{Binding SourceCodeUrl}"
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource Primary}"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenBrowserCommand}"
                                                          CommandParameter="{Binding SourceCodeUrl}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Label Text="{Binding ExtraPasswordsInfo}"
                               IsVisible="{Binding ExtraPasswordsInfo, Converter={StaticResource StringNotEmptyConverter}}"
                               Style="{StaticResource Body2}" />

                        <Label Text="{Binding PrivateKeysInfo}"
                               IsVisible="{Binding PrivateKeysInfo, Converter={StaticResource StringNotEmptyConverter}}"
                               Style="{StaticResource Body2}" />
                    </VerticalStackLayout>
                </Border>

                <!-- One paragraph, the copyright followed by where to find the third-party information. -->
                <Label Style="{StaticResource Caption1}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Copyright}" />
                            <Span Text=" " />
                            <Span Text="{Binding ThirdPartyNotice}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </controls:FadingScrollView>
</pages:PageBase>
