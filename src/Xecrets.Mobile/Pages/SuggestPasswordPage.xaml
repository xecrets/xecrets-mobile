<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
             xmlns:f="clr-namespace:Fonts"
             xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
             xmlns:pages="clr-namespace:Xecrets.Mobile.Pages"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
             x:Class="Xecrets.Mobile.Pages.SuggestPasswordPage"
             x:Name="PageRoot"
             x:DataType="pageModels:SuggestPasswordPageModel">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior x:TypeArguments="system:EventArgs"
                                        x:DataType="pages:SuggestPasswordPage"
                                        BindingContext="{x:Reference PageRoot}"
                                        EventName="Appearing"
                                        Command="{Binding InitializeCommand}" />
    </ContentPage.Behaviors>
    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="ContentRoot"
                                 Padding="{StaticResource LayoutPadding}"
                                 Spacing="{StaticResource LayoutSpacing}">
                <Border x:Name="ContentColumn"
                        HorizontalOptions="Center"
                        Style="{StaticResource PageInformationCardStyle}">
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid x:Name="ContentBody" Grid.Row="1" Padding="{StaticResource PageInformationBodyPadding}">
                            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                            <Label Text="{x:Static modelUtilities:MobileTexts.MenuSuggestPassword}"
                                   HorizontalOptions="Center"
                                   Style="{StaticResource Title1}" />
                            <controls:PageMessages MessageText="{Binding MessageText}"
                                                   StatusText="{Binding StatusText}" />
                            <VerticalStackLayout x:Name="ActionButtonStack"
                                                 HorizontalOptions="Center"
                                                 Spacing="{StaticResource LayoutSpacing}">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="{StaticResource IconRowSpacing}"
                                      Margin="{StaticResource IconRowMargin}">
                                    <ImageButton Grid.Column="0"
                                                 Background="Transparent"
                                                 Padding="8"
                                                 Command="{Binding SuggestStrongPasswordCommand}">
                                        <ImageButton.Source>
                                            <FontImageSource Glyph="{x:Static f:FluentUI.fast_forward_28_regular}"
                                                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                             Size="28" />
                                        </ImageButton.Source>
                                    </ImageButton>
                                    <Entry Grid.Column="1"
                                           Text="{Binding StrongPassword}"
                                           FontFamily="{StaticResource MonospaceFontFamily}"
                                           FontSize="16"
                                           Keyboard="Plain"
                                           IsSpellCheckEnabled="False"
                                           IsTextPredictionEnabled="False" />
                                    <ImageButton Grid.Column="2"
                                                 Background="Transparent"
                                                 Padding="8"
                                                 Command="{Binding CopyPasswordCommand}"
                                                 CommandParameter="Strong">
                                        <ImageButton.Source>
                                            <FontImageSource Glyph="{x:Static f:FluentUI.copy_24_regular}"
                                                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                             Size="28" />
                                        </ImageButton.Source>
                                    </ImageButton>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="{StaticResource IconRowSpacing}"
                                      Margin="{StaticResource IconRowMargin}">
                                    <ImageButton Grid.Column="0"
                                                 Background="Transparent"
                                                 Padding="8"
                                                 Command="{Binding SuggestSimplePasswordCommand}">
                                        <ImageButton.Source>
                                            <FontImageSource Glyph="{x:Static f:FluentUI.fast_forward_28_regular}"
                                                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                             Size="28" />
                                        </ImageButton.Source>
                                    </ImageButton>
                                    <Entry Grid.Column="1"
                                           Text="{Binding SimplePassword}"
                                           FontFamily="{StaticResource MonospaceFontFamily}"
                                           FontSize="16"
                                           Keyboard="Plain"
                                           IsSpellCheckEnabled="False"
                                           IsTextPredictionEnabled="False" />
                                    <ImageButton Grid.Column="2"
                                                 Background="Transparent"
                                                 Padding="8"
                                                 Command="{Binding CopyPasswordCommand}"
                                                 CommandParameter="Simple">
                                        <ImageButton.Source>
                                            <FontImageSource Glyph="{x:Static f:FluentUI.copy_24_regular}"
                                                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                             Size="28" />
                                        </ImageButton.Source>
                                    </ImageButton>
                                </Grid>
                            </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                        <controls:PageInformationButton Grid.Row="0"
                                                        Style="{StaticResource PageInformationButtonCorner}"
                                                        Title="{x:Static modelUtilities:MobileTexts.MenuSuggestPassword}"
                                                        Message="{x:Static modelUtilities:MobileTexts.SuggestPasswordDescription}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
