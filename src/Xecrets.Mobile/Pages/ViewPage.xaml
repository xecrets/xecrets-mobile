<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
             xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
             xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
             x:Class="Xecrets.Mobile.Pages.ViewPage"
             x:ClassModifier="internal"
             x:DataType="pageModels:ViewPageModel">
    <!-- The same layout as the edit page. The card holds the file and the buttons, with no title since the
         breadcrumb names the page. The messages below it take no space when there are none, and the contents below
         them span the full page width, and are all that scrolls. -->
    <Grid RowDefinitions="Auto,*"
          RowSpacing="{StaticResource LayoutSpacing}">
        <VerticalStackLayout Padding="{StaticResource FullWidthTextHeaderPadding}"
                             Spacing="{StaticResource LayoutSpacing}">
            <controls:PageBreadcrumb Text="{Binding Breadcrumb}" />
            <Border Style="{StaticResource PageInformationCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Margin="{StaticResource IconRowBodyLeadingMargin}"
                                         VerticalOptions="Center">
                        <Label Text="{Binding FileNameText}"
                               Style="{StaticResource FileName}" />
                        <Label Text="{Binding MetadataText}"
                               Style="{StaticResource ExtraFileInfo}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1"
                                           VerticalOptions="Start">
                        <controls:TextFontButtons BindingContext="{Binding Font}"
                                                  IsVisible="{Binding IsVisible, Source={x:Reference TextContent}, x:DataType=ScrollView}" />
                        <controls:PageInformationButton Style="{StaticResource PageInformationButtonCorner}"
                                                        Title="{x:Static modelUtilities:MobileTexts.ViewContentTitle}"
                                                        Message="{x:Static modelUtilities:MobileTexts.ViewDescription}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
            <controls:PageMessages MessageText="{Binding MessageText}"
                                   StatusText="{Binding StatusText}" />
        </VerticalStackLayout>
        <Image Grid.Row="1"
               IsVisible="{Binding IsImageVisible}"
               Aspect="AspectFit">
            <Image.Source>
                <FileImageSource File="{Binding ImageFilePath}" />
            </Image.Source>
        </Image>
        <!-- As on the edit page, the scroll view scrolls the text, since the editor's own scrolling does not fling.
             It also keeps the start of the text in view, where the editor's own scrolling on Android follows the
             cursor, which is put at the end of the text when it is set. -->
        <ScrollView x:Name="TextContent"
                    Grid.Row="1"
                    IsVisible="{Binding IsTextVisible}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
            <controls:ReadOnlyEditor Text="{Binding Text, Mode=OneWay}"
                                     AutoSize="TextChanges"
                                     BackgroundColor="Transparent"
                                     FontSize="{Binding Font.FontSize}">
                <controls:ReadOnlyEditor.Triggers>
                    <DataTrigger TargetType="controls:ReadOnlyEditor"
                                 Binding="{Binding Font.IsProportionalFont}"
                                 Value="False">
                        <Setter Property="FontFamily"
                                Value="{StaticResource MonospaceFontFamily}" />
                    </DataTrigger>
                </controls:ReadOnlyEditor.Triggers>
            </controls:ReadOnlyEditor>
        </ScrollView>
    </Grid>
</ContentPage>
