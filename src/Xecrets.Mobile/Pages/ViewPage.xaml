<pages:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:f="clr-namespace:Fonts"
                xmlns:behaviors="clr-namespace:Xecrets.Mobile.Behaviors"
                xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
                xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
                xmlns:pages="clr-namespace:Xecrets.Mobile.Pages"
                xmlns:system="clr-namespace:System;assembly=System.Runtime"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
                xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
                x:Class="Xecrets.Mobile.Pages.ViewPage"
                x:ClassModifier="internal"
                x:TypeArguments="pageModels:ViewPageModel"
                x:Name="PageRoot"
                x:DataType="pageModels:ViewPageModel">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior x:TypeArguments="system:EventArgs"
                                        x:DataType="pages:ViewPage"
                                        BindingContext="{x:Reference PageRoot}"
                                        EventName="Appearing"
                                        Command="{Binding Model.InitializeCommand}" />
    </ContentPage.Behaviors>
    <ContentPage.Resources>
        <ResourceDictionary>
            <utilities:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <FontImageSource x:Key="IconSearch"
                             Glyph="{x:Static f:FluentUI.search_24_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="24" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <!-- The same layout as the edit page. The card holds the file and the buttons, with no title since the
         breadcrumb names the page. The messages below it take no space when there are none, and the contents below
         them span the full page width, and are all that scrolls. -->
    <Grid RowDefinitions="Auto,*"
          RowSpacing="{StaticResource LayoutSpacing}">
        <VerticalStackLayout Padding="{StaticResource FullWidthTextHeaderPadding}">
            <controls:PageBreadcrumb Text="{Binding Breadcrumb}" />
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                <!-- The search takes the place of the card while it is open, and the card returns when it is closed. -->
                <Border Style="{StaticResource PageInformationCardStyle}"
                        IsVisible="{Binding Search.IsOpen, Converter={StaticResource InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Margin="{StaticResource IconRowBodyLeadingMargin}"
                                             VerticalOptions="Center">
                            <Label Text="{Binding FileNameText}"
                                   Style="{StaticResource FileName}" />
                            <Label Text="{Binding MetadataText}"
                                   Style="{StaticResource ExtraFileInfo}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1"
                                               VerticalOptions="Start"
                                               IsVisible="{Binding IsVisible, Source={x:Reference TextContent}, x:DataType=controls:TextScrollHost}">
                            <ImageButton VerticalOptions="Center"
                                         Background="Transparent"
                                         MinimumWidthRequest="36"
                                         Padding="6,8"
                                         Source="{StaticResource IconSearch}"
                                         Command="{Binding Search.OpenCommand}" />
                            <controls:TextFontButtons BindingContext="{Binding Font}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
                <controls:TextSearchBar BindingContext="{Binding Search}" />
                <controls:PageMessages MessageText="{Binding MessageText}"
                                       StatusText="{Binding StatusText}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
        <Image Grid.Row="1"
               IsVisible="{Binding IsImageVisible}"
               Aspect="AspectFit">
            <Image.Source>
                <FileImageSource File="{Binding ImageFilePath}" />
            </Image.Source>
        </Image>
        <!-- As on the edit page, the host scrolls the text. On Android its scroll view also keeps the start of the
             text in view, where the editor's own scrolling follows the cursor, which is put at the end of the text
             when it is set. -->
        <controls:TextScrollHost x:Name="TextContent"
                                 Grid.Row="1"
                                 IsVisible="{Binding IsTextVisible}"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
            <controls:ReadOnlyEditor Text="{Binding Text, Mode=OneWay}"
                                     BackgroundColor="Transparent"
                                     FontSize="{Binding Font.FontSize}">
                <controls:ReadOnlyEditor.Behaviors>
                    <behaviors:TextSearchHighlightBehavior x:DataType="pages:ViewPage"
                                                           BindingContext="{x:Reference PageRoot}"
                                                           Result="{Binding Model.Search.Result}"
                                                           MatchColor="{StaticResource TextMatch}"
                                                           CurrentMatchColor="{StaticResource CurrentTextMatch}" />
                </controls:ReadOnlyEditor.Behaviors>
                <controls:ReadOnlyEditor.Triggers>
                    <DataTrigger TargetType="controls:ReadOnlyEditor"
                                 Binding="{Binding Font.IsProportionalFont}"
                                 Value="False">
                        <Setter Property="FontFamily"
                                Value="{StaticResource MonospaceFontFamily}" />
                    </DataTrigger>
                </controls:ReadOnlyEditor.Triggers>
            </controls:ReadOnlyEditor>
        </controls:TextScrollHost>
    </Grid>
</pages:PageBase>
