<!-- A scroll view with a fade and a chevron over its top and bottom edges, showing that there is more to scroll to. They
     are only visible when there is, and let taps through to the content below them. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             x:Class="Xecrets.Mobile.Controls.FadingScrollView"
             x:ClassModifier="internal">
    <ContentView.Content>
        <Grid>
            <ScrollView x:Name="Scroll" />
            <Grid x:Name="TopScrollFade"
                  IsVisible="False"
                  InputTransparent="True"
                  VerticalOptions="Start"
                  HeightRequest="{StaticResource ScrollFadeHeight}">
                <BoxView BackgroundColor="Transparent">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="TopFadeEdge" Offset="0" />
                            <GradientStop x:Name="TopFadeInner" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Label Text="{x:Static f:FluentUI.chevron_up_16_regular}"
                       FontFamily="{x:Static f:FluentUI.FontFamily}"
                       FontSize="{StaticResource ScrollChevronSize}"
                       LineHeight="1"
                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                       HorizontalOptions="Center"
                       VerticalOptions="Start" />
            </Grid>
            <Grid x:Name="BottomScrollFade"
                  IsVisible="False"
                  InputTransparent="True"
                  VerticalOptions="End"
                  HeightRequest="{StaticResource ScrollFadeHeight}">
                <BoxView BackgroundColor="Transparent">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="BottomFadeInner" Offset="0" />
                            <GradientStop x:Name="BottomFadeEdge" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Label Text="{x:Static f:FluentUI.chevron_down_16_regular}"
                       FontFamily="{x:Static f:FluentUI.FontFamily}"
                       FontSize="{StaticResource ScrollChevronSize}"
                       LineHeight="1"
                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                       HorizontalOptions="Center"
                       VerticalOptions="End" />
            </Grid>
        </Grid>
    </ContentView.Content>
</ContentView>
