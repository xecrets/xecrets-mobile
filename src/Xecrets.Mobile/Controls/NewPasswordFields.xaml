<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:abstractions="clr-namespace:Xecrets.Mobile.Models.Abstractions;assembly=Xecrets.Mobile.Models"
             xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
             xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
             xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
             x:Class="Xecrets.Mobile.Controls.NewPasswordFields"
             x:ClassModifier="internal"
             x:Name="FieldsRoot"
             x:DataType="abstractions:INewPasswordPageModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <utilities:StrengthColorToColorConverter x:Key="StrengthColorToColorConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <!-- Spaced as the form around it, so that the fields are laid out as if they were directly in it. -->
    <VerticalStackLayout Spacing="{DynamicResource FormSpacing}">
        <controls:PasswordEntry Margin="{StaticResource IconRowBodyLeadingMargin}" x:Name="PasswordEntryControl"
                                Text="{Binding Password, Mode=TwoWay}"
                                Placeholder="{x:Static modelUtilities:MobileTexts.WatermarkPassword}"
                                ToolTipProperties.Text="{x:Static modelUtilities:MobileTexts.ToolTipMasterPassword}"
                                ReturnType="Next" />
        <!-- As wide as the password text field, inset to the ends of its underline. -->
        <ContentView HorizontalOptions="Start"
                     IsVisible="{Binding IsEditable}"
                     Margin="{DynamicResource PasswordStrengthMargin}"
                     Padding="{DynamicResource PasswordStrengthInset}"
                     WidthRequest="{Binding PasswordTextEntry.Width, Source={x:Reference FieldsRoot}, x:DataType=controls:NewPasswordFields}">
            <ProgressBar Progress="{Binding PasswordStrength}"
                         ProgressColor="{Binding PasswordStrengthColor, Converter={StaticResource StrengthColorToColorConverter}}">
                <!-- Opacity, not IsVisible, so the space stays reserved and nothing moves when typing starts. -->
                <ProgressBar.Triggers>
                    <DataTrigger TargetType="ProgressBar"
                                 Binding="{Binding Password}"
                                 Value="">
                        <Setter Property="Opacity"
                                Value="0" />
                    </DataTrigger>
                </ProgressBar.Triggers>
            </ProgressBar>
        </ContentView>
        <controls:PasswordEntry Margin="{StaticResource IconRowBodyLeadingMargin}" x:Name="ConfirmPasswordEntryControl"
                                IsVisible="{Binding IsEditable}"
                                Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                Placeholder="{x:Static modelUtilities:MobileTexts.WatermarkConfirmPassword}"
                                ToolTipProperties.Text="{x:Static modelUtilities:MobileTexts.ToolTipMasterPassword}"
                                ReturnType="Go"
                                ReturnCommand="{Binding ReturnCommand, Source={x:Reference FieldsRoot}, x:DataType=controls:NewPasswordFields}" />
    </VerticalStackLayout>
</ContentView>
