<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
             x:Class="Xecrets.Mobile.Controls.TextFontButtons"
             x:ClassModifier="internal"
             x:DataType="pageModels:TextEditorFontModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <FontImageSource x:Key="IconFontDecrease"
                             Glyph="{x:Static f:FluentUI.font_decrease_24_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="24" />
            <FontImageSource x:Key="IconFontIncrease"
                             Glyph="{x:Static f:FluentUI.font_increase_24_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="24" />
            <FontImageSource x:Key="IconProportionalFont"
                             Glyph="{x:Static f:FluentUI.text_font_24_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="24" />
        </ResourceDictionary>
    </ContentView.Resources>
    <HorizontalStackLayout VerticalOptions="Center">
        <!-- The same as the save button. Narrower than the usual 44, so that the row of icons is not too spread out. -->
        <ImageButton VerticalOptions="Center"
                     Background="Transparent"
                     MinimumWidthRequest="36"
                     Padding="6,8"
                     Source="{StaticResource IconFontDecrease}"
                     Command="{Binding DecreaseFontSizeCommand}" />
        <ImageButton VerticalOptions="Center"
                     Background="Transparent"
                     MinimumWidthRequest="36"
                     Padding="6,8"
                     Source="{StaticResource IconFontIncrease}"
                     Command="{Binding IncreaseFontSizeCommand}" />
        <!-- A subtle background shows that the proportional font is on. It is drawn behind the button, just around
             the glyph, since the button's own background fills the whole tap area. -->
        <Grid VerticalOptions="Center">
            <Border WidthRequest="32"
                    HeightRequest="32"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 6"
                    Background="Transparent"
                    InputTransparent="True">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding IsProportionalFont}"
                                 Value="True">
                        <Setter Property="Background"
                                Value="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}" />
                    </DataTrigger>
                </Border.Triggers>
            </Border>
            <ImageButton VerticalOptions="Center"
                         Background="Transparent"
                         MinimumWidthRequest="36"
                         Padding="6,8"
                         Source="{StaticResource IconProportionalFont}"
                         Command="{Binding ToggleProportionalFontCommand}" />
        </Grid>
    </HorizontalStackLayout>
</ContentView>
