<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
             xmlns:pageModels="clr-namespace:Xecrets.Mobile.Models.PageModels;assembly=Xecrets.Mobile.Models"
             xmlns:modelUtilities="clr-namespace:Xecrets.Mobile.Models.Utilities;assembly=Xecrets.Mobile.Models"
             xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
             x:Class="Xecrets.Mobile.Controls.TextSearchBar"
             x:ClassModifier="internal"
             x:DataType="pageModels:TextSearchModel"
             IsVisible="{Binding IsOpen}">
    <ContentView.Resources>
        <ResourceDictionary>
            <utilities:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <FontImageSource x:Key="IconFindPrevious"
                             Glyph="{x:Static f:FluentUI.chevron_up_24_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="24" />
            <FontImageSource x:Key="IconFindNext"
                             Glyph="{x:Static f:FluentUI.chevron_down_24_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="24" />
            <FontImageSource x:Key="IconClose"
                             Glyph="{x:Static f:FluentUI.dismiss_24_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="24" />
        </ResourceDictionary>
    </ContentView.Resources>
    <!-- As the search panel of the desktop app: the text to search for, the previous and next match, and close, with
         the position of the current match and the number of matches below the text. As in the find bar of Safari, the
         previous and next match come before the text and close after it, so that close is not next to them. The
         buttons are as large as the touch targets that Apple recommends, beside both the text and the count. -->
    <Border Style="{StaticResource PageInformationCardStyle}">
        <Grid Margin="{StaticResource IconRowBodyLeadingMargin}"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="Auto,Auto,*,Auto">
            <ImageButton Grid.RowSpan="2"
                         VerticalOptions="Center"
                         Background="Transparent"
                         WidthRequest="44"
                         HeightRequest="44"
                         Padding="10"
                         Source="{StaticResource IconFindPrevious}"
                         Command="{Binding FindPreviousCommand}" />
            <ImageButton Grid.Column="1"
                         Grid.RowSpan="2"
                         VerticalOptions="Center"
                         Background="Transparent"
                         WidthRequest="44"
                         HeightRequest="44"
                         Padding="10"
                         Source="{StaticResource IconFindNext}"
                         Command="{Binding FindNextCommand}" />
            <!-- No taller than the buttons, rather than as tall as the entries of a form. -->
            <controls:SearchTextEntry x:Name="SearchEntry"
                                      Grid.Column="2"
                                      MinimumHeightRequest="{StaticResource CompactEntryMinimumHeight}"
                                      Text="{Binding SearchText}"
                                      Placeholder="{x:Static modelUtilities:MobileTexts.WatermarkFind}"
                                      Keyboard="Plain"
                                      IsSpellCheckEnabled="False"
                                      IsTextPredictionEnabled="False"
                                      ReturnType="Search"
                                      ReturnCommand="{Binding FindNextCommand}"
                                      VerticalOptions="Center" />
            <Label Grid.Row="1"
                   Grid.Column="2"
                   Text="{Binding CountText}"
                   IsVisible="{Binding CountText, Converter={StaticResource StringNotEmptyConverter}}"
                   Style="{StaticResource ExtraFileInfo}" />
            <ImageButton Grid.Column="3"
                         Grid.RowSpan="2"
                         VerticalOptions="Center"
                         Background="Transparent"
                         WidthRequest="44"
                         HeightRequest="44"
                         Padding="10"
                         Source="{StaticResource IconClose}"
                         Command="{Binding CloseCommand}" />
        </Grid>
    </Border>
</ContentView>
