<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
             xmlns:utilities="clr-namespace:Xecrets.Mobile.Utilities"
             x:Class="Xecrets.Mobile.Controls.ActionButton"
             x:ClassModifier="internal"
             x:DataType="controls:ActionButton"
             x:Name="Root">
    <!-- The labels are drawn on a shape with the colors of the other buttons, and a transparent button without text
         covers it all, so that the whole button takes the click. Labels over a button take part of it on Windows. The
         button has no style, since the disabled state of the implicit one would paint over the labels. -->
    <Grid BindingContext="{x:Reference Root}"
          MinimumHeightRequest="{StaticResource TwoLineActionButtonHeight}">
        <Border StrokeThickness="0"
                Padding="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource Primary}">
            <Border.Triggers>
                <DataTrigger TargetType="Border"
                             Binding="{Binding Source={x:Reference CommandButton}, Path=IsEnabled, x:DataType=Button}"
                             Value="False">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                </DataTrigger>
            </Border.Triggers>
            <VerticalStackLayout Padding="18,8"
                                 Spacing="4"
                                 VerticalOptions="Center">
                <Label Text="{Binding Title}"
                       TextColor="{StaticResource White}"
                       utilities:Typography.FontWeight="Semibold"
                       FontSize="16"
                       LineHeight="1">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding Source={x:Reference CommandButton}, Path=IsEnabled, x:DataType=Button}"
                                     Value="False">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Text="{Binding Description}"
                       TextColor="{StaticResource White}"
                       FontSize="12"
                       LineHeight="1">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding Source={x:Reference CommandButton}, Path=IsEnabled, x:DataType=Button}"
                                     Value="False">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </Border>
        <Button x:Name="CommandButton"
                Style="{x:Null}"
                BackgroundColor="Transparent"
                BorderWidth="0"
                CornerRadius="12"
                Command="{Binding Command}"
                SemanticProperties.Description="{Binding Title}"
                SemanticProperties.Hint="{Binding Description}" />
    </Grid>
</ContentView>
