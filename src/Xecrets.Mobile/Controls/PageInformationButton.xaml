<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             x:Class="Xecrets.Mobile.Controls.PageInformationButton">
    <ImageButton Background="Transparent"
                 Padding="8"
                 Clicked="OnClicked">
        <ImageButton.Source>
            <FontImageSource Glyph="{x:Static f:FluentUI.info_28_regular}"
                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                             Color="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                             Size="28" />
        </ImageButton.Source>
    </ImageButton>
</ContentView>
