<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Xecrets.Mobile.Controls"
             x:Class="Xecrets.Mobile.Controls.PageCard"
             x:ClassModifier="internal"
             x:DataType="controls:PageCard"
             x:Name="Root"
             VerticalOptions="Start"
             HorizontalOptions="Center"
             BodyPadding="{StaticResource PageInformationBodyPadding}">
    <!-- Content is set explicitly, since Body is the content property, so that the pages can give the body directly. -->
    <ContentView.Content>
        <!-- The body and the header actions are hosted, not bound to this control as binding context, so that they
             keep the binding context of the page. The title row comes after the body so that it is drawn on top. -->
        <Border x:Name="CardBorder"
                Style="{StaticResource PageInformationCardStyle}">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="{StaticResource CardTitleSpacing}">
                <ScrollView Grid.Row="1">
                    <ContentView x:Name="BodyHost"
                                 Padding="{Binding BodyPadding, Source={x:Reference Root}, x:DataType=controls:PageCard}" />
                </ScrollView>
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Title, Source={x:Reference Root}, x:DataType=controls:PageCard}"
                           Style="{StaticResource CardTitleStyle}" />
                    <HorizontalStackLayout Grid.Column="1"
                                           VerticalOptions="Center">
                        <ContentView x:Name="HeaderActionsHost"
                                     VerticalOptions="Center" />
                        <controls:PageInformationButton Style="{StaticResource PageInformationButtonCorner}"
                                                        Title="{Binding Title, Source={x:Reference Root}, x:DataType=controls:PageCard}"
                                                        Message="{Binding Information, Source={x:Reference Root}, x:DataType=controls:PageCard}" />
                    </HorizontalStackLayout>
                </Grid>
            </Grid>
        </Border>
    </ContentView.Content>
</ContentView>
